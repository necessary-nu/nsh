                        sealed true
                        log (
                            {
                                at 2026-08-18T10:11:43.437550894Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-18T10:13:56.548887414Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Gate EOF rearming on the command loop's existing interactive-input classifier. A top-level command file or stdin script terminates at physical EOF even if it set ignoreeof; an interactive root loop with ignoreeof continues indefinitely, while the stopped-job retry cap remains unchanged. Verification: both focused POSIX cases, 14 harness tests, the complete 731-case POSIX harness, and 255 nsh core tests pass."
                            }

                            {
                                at 2026-08-18T10:13:56.638277641Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }

                            {
                                at 2026-08-18T11:42:49.719683972Z
                                author "brendan@necessary.nu"
                                kind @errata
                                text "Model correction: the interactive-input classification must be captured when cmdloop starts. The live `inter` value is derived again after each command, so a non-interactive command file that executes `set -i` can change it; it is therefore not the input-source classifier the original decision described. A command file or stdin script remains non-interactive at physical EOF even after runtime `set -i`, while an interactive top-level loop retains ignoreeof retry behavior. The strengthened POSIX case sets both -i and ignoreeof; the 731-case harness and 255 core tests pass."
                                after_done true
                            }
                        )
                    }

                    {
                        id posix.nonconformance.dot-prints-a-newline
                        title "Stop `.` printing a blank line at an interactive prompt"
                        kind @fix
                        constrained_by ([spec:nsh:sem:idiom.specified-defects+1])
                        deps (harness.oils-baseline-is-behind)
                        sealed true
                        log (
                            {
                                at 2026-09-02T14:42:35.109969337Z
                                author "brendan@necessary.nu"
                                kind @blocker
                                text "`. FILE` AT AN INTERACTIVE PROMPT PRINTS A BLANK LINE dash DOES NOT. Found 2026-09-02 while closing `deliver-a-prompt-interrupt-without-eating-the-next-line`, as the one case out of fifteen in that node's signal matrix that still differed from dash after the fix -- and then found to have nothing to do with signals at all.\n\nMEASURED on a pseudo-terminal with `TERM=dumb`, `PS1='$ '`, against `/usr/bin/dash`, with a shell built at `a81455c` and with one built from its parent, identically:\n\n    file holds `echo IN-DOT`\n      dash  $ . d1.sh <nl> IN-DOT <nl> $ echo b\n      nsh   $ . d1.sh <nl> IN-DOT <nl> <nl> $ echo b\n\n    file holds `:` and prints nothing\n      dash  $ . d3.sh <nl> $ echo b\n      nsh   $ . d3.sh <nl> <nl> $ echo b\n\nSo it is not about what the file printed and not about a missing final newline: the extra line is there when the file produces no output at all. It is the `.` itself.\n\nIT IS THE BUILT-IN AND NOT THE GENERAL CASE, which is what makes it worth a node rather than a shrug. The two other ways of running shell text from a prompt agree with dash exactly: `eval 'echo IN-EVAL'` and `x=$(echo sub); echo $x` both give byte-identical transcripts in both shells. Only the input-frame that `.` pushes leaves the extra newline behind, so the place to look is where that frame is popped and where the prompt decides whether the cursor is at the start of a line -- not in `eval`'s or the substitution's path, which share most of the rest.\n\nWHY IT IS EASY TO MISATTRIBUTE, and this cost a measurement here. Under a signal test the extra line lands next to the newline an interrupt prints, and reads as the interrupt printing two. Both binaries above were measured with no signal involved, one line of script each, which is what told the two apart.\n\nNOT MEASURED YET, and worth doing before fixing: whether the pinned Bash 5.3 prints the extra line (this repository's `.` is dash's, but the Bash profile has to agree with whichever answer is chosen), whether a non-interactive `.` is affected at all -- no survey case has moved, so probably not -- and whether `source` in Bash mode takes the same path.\n\nDONE WHEN `. FILE` at an interactive prompt writes exactly what dash writes for a file that prints something and for one that prints nothing, and a case covers both so the blank line cannot come back beside a signal where nobody will see it."
                            }

                            {
                                at 2026-09-04T21:09:10.347561244Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-09-04T21:28:18.722503503Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }
                )
            }
        )
    }

