                        id fix-edit-stty-character-refresh
                        title "Refresh line-editor terminal characters after stty changes"
                        kind @fix
                        sealed true
                        log (
                            {
                                at 2026-08-18T06:33:12.007967412Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-18T06:42:02.030903837Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Preserve successful tty changes from completed foreground utilities by restoring the shell snapshot only when a job stops. Before each subsequent edited line, read the cooked terminal attributes, replace the editor terminal's safe shared snapshots, reset stale keymaps, and reinstall shell bindings from the current control characters. This keeps stopped-job restoration intact while making `stty erase` observable immediately. Verification: the stty-erase case, adjacent erase/kill/word-erase case, all three foreground/suspension terminal cases, 255 core tests plus companion tests/doctests, and git diff --check pass."
                            }

                            {
                                at 2026-08-18T12:02:07.487828669Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

                    {
                        id spec-default-history-navigation
                        title "Specify baseline interactive history navigation"
                        kind @docs
                        deps (fix-edit-stty-character-refresh)
                        sealed true
                        log (
                            {
                                at 2026-08-18T12:02:24.097465517Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-18T12:02:46.955813943Z
                                author "brendan@necessary.nu"
                                kind @decision
                                text "Define native line editing as the baseline for interactive terminal sessions: Up selects older retained commands and Down selects newer commands or the live line. The vi and emacs shell options select extended keymaps and do not gate editor initialization."
                            }

                            {
                                at 2026-08-18T12:02:47.032570368Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

