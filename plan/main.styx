                                                at 2026-09-03T17:23:09.253467638Z
                                                author "brendan@necessary.nu"
                                                kind @status
                                                text "Todo → Doing (nplan start)"
                                            }

                                            {
                                                at 2026-09-03T17:25:06.226390647Z
