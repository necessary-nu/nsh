                title "Correct dash's POSIX non-conformances in the port"
                kind @fix
                deps (shell-as-library)
                children (
                    {
                        id fix-builtin-alias-stdout-format
                        title "builtin.alias.stdout-format: The format for displaying aliases (when no operands or only name operands are..."
                        implements {
                            shell ([spec:posix:req:builtin.alias.stdout-format])
                        }
                        deps (shell-as-library)
                        log (
                            {
                                at 2026-08-18T03:00:18.483873053Z
