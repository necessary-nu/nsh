    {
        id shell-as-library
        title "Make nsh a shell library with a binary frontend, per [dec:nsh:shell-as-library]"
        priority 0
        kind @refactor
        children (
            {
                id host-owns-streams
                title "The shell's three streams come from the frontend, not descriptors 0/1/2"
                priority 0
                kind @feat
                sealed true
                log (
                    {
                        at 2026-08-07T09:11:54.770587255Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-08-07T09:33:13.662151863Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id errors-are-values
                title "Replace the longjmp-as-unwind exception mechanism with Result propagation"
                priority 0
                kind @refactor
                deps (delete-memalloc sanctioned-divergences public-api-design)
            }

            {
                id no-ambient-state
                title "Move every process-global static into a shell instance; no globals, no thread-locals"
                priority 0
                kind @refactor
                deps (errors-are-values sanctioned-divergences public-api-design)
                children (
                    {
                        id thread-context
                        title "Thread a context parameter through every function that touches a static"
                        priority 0
                        kind @refactor
                        deps (errors-are-values public-api-design)
                    }

                    {
                        id move-state
                        title "Move each static table onto the shell instance, one table per commit"
                        priority 0
                        kind @refactor
                        deps (thread-context)
                    }
                )
            }

            {
                id host-owns-signals
                title "The frontend claims signal dispositions; needs pty cases for job control first"
                priority 0
                kind @refactor
                deps (no-ambient-state)
            }

            {
                id owned-data
                title "Delete memalloc: the shell's data becomes owned Rust values, per [dec:nsh:owned-data]"
                priority 0
                kind @refactor
                children (
                    {
                        id owned-nodes
                        title "union node becomes an owned Rust enum; copyfunc becomes Rc + Clone"
                        priority 0
                        kind @refactor
                        sealed true
                        log (
                            {
                                at 2026-08-07T09:34:17.049858598Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Todo → Doing (nplan start)"
                            }

                            {
                                at 2026-08-07T11:42:00.055092499Z
                                author "brendan@necessary.nu"
                                kind @status
                                text "Doing → Done (nplan complete)"
                            }
                        )
                    }

                    {
                        id owned-strings
                        title "The stack string builder becomes an owned byte vector across parser and expand"
                        priority 0
                        kind @refactor
                        deps (owned-nodes sanctioned-divergences)
                    }

                    {
                        id delete-memalloc
                        title "Move the last region allocations to ownership and delete memalloc.rs"
                        priority 0
                        kind @refactor
                        deps (owned-strings)
                    }

                    {
                        id delete-gen
                        title "Delete dead code: gen/, show.rs, and the 20 uncalled system.rs wrappers"
                        priority 0
                        kind @refactor
                    }
                )
            }

            {
                id sanctioned-divergences
                title "Make the differential tally mean what it says: sanctioned divergences, and a dead harness that reports as one"
                priority 0
                kind @test
                log (
                    {
                        at 2026-08-08T08:24:19.29009759Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id crate-rename
                title "Rename the crate to nsh and split the frontend into nsh-cli"
                priority 0
                kind @refactor
                sealed true
                log (
                    {
                        at 2026-08-07T14:04:44.997768512Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-08-08T02:12:48.664729127Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id nshedit-in-tree
                title "Publish nshedit so nsh can be published; the git dep only fixes clone-and-build"
                priority 0
                kind @build
            }

            {
                id output-is-a-writer
                title "output.rs becomes a writer the shell holds, not four statics on descriptors"
                priority 0
                kind @refactor
                deps (delete-memalloc)
            }

            {
                id builtins-take-args
                title "The 40 builtins stop taking argc and a raw char pointer array"
                priority 0
                kind @refactor
                deps (owned-strings)
            }

            {
                id public-api-design
                title "Design the public API: Shell, Error taxonomy, and what run() means when called twice"
                priority 0
                kind @docs
                log (
                    {
                        at 2026-08-08T08:50:26.111500849Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }
                )
            }

            {
                id process-model
                title "fork, exec and wait in a library: what a Shell may do to the process"
                priority 0
                kind @refactor
                deps (no-ambient-state)
            }

            {
                id public-api
                title "Implement the public API and close the surface: 35 pub mod down to what an embedder needs"
                priority 0
                kind @feat
                deps (no-ambient-state host-owns-signals public-api-design)
            }
        )
    }
)
