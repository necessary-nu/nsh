#!/bin/bash
# Run an entire test command behind the same fail-closed boundary used for
# hostile shell cases. This protects the caller even when the harness code
# itself regresses before it reaches its per-case sandbox.
set -euo pipefail

usage() {
    echo "usage: scripts/sandboxed [--writable PATH]... [--timeout SECONDS] -- COMMAND [ARG...]" >&2
    echo "       scripts/sandboxed --cargo-runner -- PROGRAM [ARG...]" >&2
    echo "SECONDS may be fractional; 0 means no limit." >&2
    exit 2
}

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
SANDBOX=${NSH_TEST_SANDBOX:-sandbox}
DEFAULT_BUDGET=900
TIMEOUT=${NSH_TEST_TIMEOUT:-$DEFAULT_BUDGET}
NPROC=${NSH_TEST_NPROC:-256}
# Where the command starts. A command typed at this wrapper is a command about
# the repository, so it starts at the root; a binary cargo hands us is one
# cargo already chose a directory for, and moving it would change what the
# program under test sees.
CHDIR=$ROOT
# `--cargo-runner` is this wrapper standing where `.cargo/config.toml` points
# cargo, so that `cargo test` and `cargo run` carry the boundary themselves
# rather than depending on somebody typing the wrapper first. See the comment
# in `.cargo/config.toml` for why that indirection exists at all.
RUNNER=false
# How much longer than the command's own budget the outer deadline waits. It
# only has to outlast the inner `timeout`'s TERM and the KILL a second behind
# it; it fires for a sandbox that never got as far as running anything, which
# is the one thing the inner budget cannot cover. Five seconds is what
# `ds_sandboxed` uses, and there is no reason for the two shell wrappers to
# disagree.
BACKSTOP=5

# A budget may be fractional, because a case-sized budget is exactly what a
# focused run wants and `timeout` takes one; a run that means to be watched
# rather than bounded says `0`, which is GNU `timeout`'s own spelling for no
# limit and the one `fuzz/run.sh` passes for "run until interrupted".
valid_seconds() { # valid_seconds VALUE
    [[ $1 =~ ^[0-9]+(\.[0-9]+)?$ ]]
}
valid_seconds "$TIMEOUT" || usage
case $NPROC in
    ''|*[!0-9]*|0) usage ;;
esac
command -v "$SANDBOX" >/dev/null 2>&1 || {
    echo "scripts/sandboxed: '$SANDBOX' was not found; refusing to run tests unsandboxed" >&2
    exit 1
}
SANDBOX=$(command -v "$SANDBOX")

mkdir -p "$ROOT/target"
WRITABLES=("$(cd "$ROOT/target" && pwd -P)")
while (($#)); do
    case $1 in
        --writable)
            (($# >= 2)) || usage
            [[ -e $2 ]] || {
                echo "scripts/sandboxed: writable path does not exist: $2" >&2
                exit 1
            }
            path=$(cd "$2" 2>/dev/null && pwd -P) || {
                echo "scripts/sandboxed: writable path must be a directory: $2" >&2
                exit 1
            }
            [[ $path != "$ROOT" ]] || {
                echo "scripts/sandboxed: refusing to make the whole repository writable" >&2
                exit 1
            }
            WRITABLES+=("$path")
            shift 2
            ;;
        --timeout)
            (($# >= 2)) || usage
            TIMEOUT=$2
            valid_seconds "$TIMEOUT" || usage
            shift 2
            ;;
        --cargo-runner)
            RUNNER=true
            CHDIR=$(pwd -P)
            shift
            ;;
        --)
            shift
            break
            ;;
        *) usage ;;
    esac
done
(($#)) || usage

# No budget stays no budget on the way out as well as on the way in: adding
# the backstop to zero would turn "run until interrupted" into a five-second
# limit, which is the one way this change could have broken an open-ended
# fuzzing campaign.
OUTER_TIMEOUT=$(/usr/bin/awk -v t="$TIMEOUT" -v b="$BACKSTOP" \
    'BEGIN { printf "%.3f\n", (t == 0 ? 0 : t + b) }')

# A FULL FILESYSTEM DOES NOT SAY SO; IT SAYS THE COMPILER CRASHED.
#
# On 2026-09-02 a `cargo test --workspace` in a fresh worktree reported, for
# eight test binaries at once:
#
#     collect2: fatal error: ld terminated with signal 7 [Bus error], core dumped
#     PLEASE submit a bug report to https://github.com/llvm/llvm-project/issues/
#      #4 llvm::StringTableBuilder::write(unsigned char*) const
#      #7 lld::elf::MergeNoTailSection::writeTo(unsigned char*)
#
# an LLVM stack trace and an invitation to file an upstream bug. It is
# neither: SIGBUS inside `memcpy` under `writeTo` is the linker writing into
# an mmap'd output file it can no longer extend, and `df -h /` read 100% at
# that moment. The same cause produced, within the same hour, a `rustc` ICE
# carrying no message at all and a `cargo` ENOSPC -- three signatures for one
# condition, and only the third contains the word "space". An hour went into
# the first of them before anybody ran `df`.
#
# THE THRESHOLD IS NOT "ENOUGH TO BUILD", AND DOES NOT CLAIM TO BE. This
# wrapper cannot know whether the command behind the `--` is a clean build of
# the workspace or a one-crate rebuild, so it cannot answer whether the output
# will fit. What it can answer is whether the machine is in the state where a
# failure stops naming its own cause. Measured here on 2026-09-02 at load
# 15-20, building into a scratch `CARGO_TARGET_DIR` on another filesystem:
#
#   2.79 GiB  a from-clean `cargo test --workspace --no-run`, peak and final
#             alike -- the tree grows monotonically, so there is no transient
#             link spike to budget for over and above the tree itself
#   1.50 GiB  linker output in flight at once: `nproc` (32 here) parallel link
#             jobs times the largest link output in this workspace, 48.1 MiB
#   1.6 GiB   free when `cargo` reported ENOSPC and named it
#   670 MiB   free when the linker took the bus error quoted above
#
# 2 GiB is above the in-flight link figure and above both recorded failure
# points, and below what a clean full build needs. So a machine that passes
# this check may still not fit its build -- and `cargo` will say so, in those
# words -- while a machine that fails it is one whose next failure would have
# lied about why.
#
# It is asked before the abandoned-process scan because it is far cheaper: two
# `statfs` calls against that scan's 91-162 ms walk of /proc.
if $RUNNER; then
    DISK=ignore
else
    DISK=${NSH_TEST_DISK:-refuse}
fi
case $DISK in
    refuse | warn | ignore) ;;
    *)
        echo "scripts/sandboxed: NSH_TEST_DISK must be refuse, warn or ignore" >&2
        exit 2
        ;;
esac
DISK_MIN=${NSH_TEST_DISK_MIN:-2048}
case $DISK_MIN in
    '' | *[!0-9]*)
        echo "scripts/sandboxed: NSH_TEST_DISK_MIN must be a number of mebibytes" >&2
        exit 2
        ;;
esac

# `%a` is the count of blocks a non-superuser may still use and `%S` the size
# of one; the product is what `df` reports as "Avail", checked against
# `df -B1` on all three filesystems of this machine.
free_bytes() { # free_bytes PATH
    local blocks size
    blocks=$(/usr/bin/stat -f -c '%a' "$1") || return 1
    size=$(/usr/bin/stat -f -c '%S' "$1") || return 1
    printf '%s\n' "$((blocks * size))"
}

# The question is about the filesystems this run may write to, which is
# exactly the set of paths bound writable -- `$ROOT/target` always, plus
# whatever `--writable` named. A worktree measuring into its own
# `CARGO_TARGET_DIR` is the case this was filed for, and it is covered because
# that directory has to be bound to be written. Two paths on one filesystem
# are one question, so the scan is per device rather than per path.
if [[ $DISK != ignore ]]; then
    DISK_MINIMUM=$((DISK_MIN * 1024 * 1024))
    SEEN_DEVICES=' '
    SHORT_PATHS=()
    SHORT_REPORTS=()
    for path in "${WRITABLES[@]}"; do
        device=$(/usr/bin/stat -c '%d' "$path") || continue
        [[ $SEEN_DEVICES != *" $device "* ]] || continue
        SEEN_DEVICES+="$device "
        available=$(free_bytes "$path") || continue
        ((available < DISK_MINIMUM)) || continue
        SHORT_PATHS+=("$path")
        SHORT_REPORTS+=("$(/usr/bin/awk -v p="$path" -v a="$available" -v m="$DISK_MINIMUM" \
            -v s="$(/usr/bin/df --output=source -- "$path" | /usr/bin/tail -n 1)" \
            'BEGIN { printf "%s is on %s with %.2f GiB free, under %.2f GiB", p, s, a / 1073741824, m / 1073741824 }')")
    done
    if ((${#SHORT_PATHS[@]})); then
        for report in "${SHORT_REPORTS[@]}"; do
            echo "scripts/sandboxed: $report" >&2
        done
        echo "scripts/sandboxed: below that mark a build's failure stops naming its own" >&2
        echo "cause. A linker out of room dies as 'ld terminated with signal 7 [Bus" >&2
        echo "error]' under an LLVM stack trace asking for an upstream bug report, and" >&2
        echo "rustc dies as an ICE with no message; only cargo itself ever says 'No" >&2
        echo "space left on device'. Run df before believing either of the first two." >&2
        if [[ $DISK == warn ]]; then
            echo "scripts/sandboxed: running anyway because NSH_TEST_DISK=warn" >&2
        else
            echo "scripts/sandboxed: refusing to start a build that would fail this way." >&2
            echo "Free some space, or re-run with NSH_TEST_DISK=warn to run anyway or" >&2
            echo "=ignore to skip the check. NSH_TEST_DISK_MIN is the threshold in" >&2
            echo "mebibytes." >&2
            exit 1
        fi
    fi
fi

# An abandoned case is one this wrapper can still see. Everything the
# repository runs against shell-controlled input goes into a PID namespace
# and dies with it, so a shell built into a `target/` directory, sitting at
# ppid 1, in *this* process's PID namespace, was started outside every
# boundary the repository has -- by hand, or by a harness that has since
# been killed. Nothing else then bounds it: on 2026-08-31 four such shells
# spun at 98% CPU for forty-seven hours after their worktree, their binary
# and their case files had all been deleted, and no timeout could reach
# them because none had ever been put in front of them.
#
# The fingerprint names the binaries this repository builds and points at
# hostile input, rather than everything under a `target/` directory: this
# machine carries checkouts of other projects whose own orphaned test
# binaries are none of our business. Worktrees are why the path is not
# anchored at $ROOT -- nplan keeps this repository's worktrees outside it.
#
# ORPHANED IS NOT YET ABANDONED, which is the 2026-09-02 correction and
# the first thing this check got wrong. Its first run refused because
# another session had a `target/spell/nsh` probe of its own, 37 seconds
# old, at ppid 1 and 98% CPU -- the incident's exact shape and somebody's
# live measurement. A process is only abandoned once it has outlived
# anything that could still be waiting for it, so the age has to be part
# of the fingerprint. The default is this wrapper's own budget: nothing
# it starts may live longer than $TIMEOUT, so a process outside every
# boundary that has outlived it is abandoned by the wrapper's own
# definition. It catches the forty-seven-hour case in fifteen minutes
# instead of never, and it never catches a probe somebody is watching.
#
# The check runs here rather than inside the boundary because inside it
# there is nothing to see: the sandbox mounts a fresh /proc in a fresh PID
# namespace, so a contained run cannot observe the host's leftovers. It
# runs before the containment canary so that a machine in this state costs
# a refusal rather than a test run.
abandoned_processes() { # abandoned_processes MINIMUM-AGE-SECONDS
    local minimum=$1 own line rest pid parent exe stat uptime ticks age
    local -a fields
    own=$(/usr/bin/readlink /proc/self/ns/pid) || return 0
    read -r uptime _ < /proc/uptime || return 0
    uptime=${uptime%%.*}
    ticks=$(/usr/bin/getconf CLK_TCK) || return 0
    for stat in /proc/[0-9]*/stat; do
        pid=${stat#/proc/}
        pid=${pid%/stat}
        read -r line 2>/dev/null < "$stat" || continue
        # Field 2 is the command in parentheses and may contain spaces and
        # ')', so the fields after it start at the *last* ") ". What is
        # left begins at field 3, so fields[1] is the parent and
        # fields[19] is field 22, the start time in clock ticks.
        rest=${line##*') '}
        fields=($rest)
        parent=${fields[1]}
        [[ $parent == 1 ]] || continue
        age=$((uptime - fields[19] / ticks))
        ((age >= minimum)) || continue
        exe=$(/usr/bin/readlink "/proc/$pid/exe" 2>/dev/null) || continue
        [[ $exe == */target/* ]] || continue
        case ${exe% (deleted)} in
            */nsh | */nsh-survey | */bash | */dash) ;;
            *) continue ;;
        esac
        [[ $(/usr/bin/readlink "/proc/$pid/ns/pid" 2>/dev/null) == "$own" ]] || continue
        printf '%s\n' "$pid"
    done
}

# The scan is a question about the machine a test command is about to start
# on, and `--cargo-runner` is not the start of a command: cargo calls this
# wrapper once per test binary, so a workspace run would ask it sixty-two
# times, pay 91-162 ms of /proc walk for each, and could refuse in the middle
# of a suite for a process that crossed the age threshold while the suite ran.
# The command-level wrapper still asks it once, which is where the question
# belongs.
if $RUNNER; then
    ABANDONED=ignore
else
    ABANDONED=${NSH_TEST_ABANDONED:-refuse}
fi
case $ABANDONED in
    refuse | kill | ignore) ;;
    *)
        echo "scripts/sandboxed: NSH_TEST_ABANDONED must be refuse, kill or ignore" >&2
        exit 2
        ;;
esac
# The age threshold still follows this wrapper's own budget, and now has to
# survive two budgets that could not be spelled before. A fractional one is
# rounded up, because a threshold of zero calls every orphan on the machine
# abandoned -- which is exactly the mistake the 2026-09-02 erratum on
# `kill-a-survey-case-the-harness-abandoned` was written against, and it was
# already reachable: `--timeout 0` set the threshold to zero, so
# `fuzz/run.sh`'s open-ended campaign refused to start whenever any orphaned
# repository binary sat at ppid 1, whatever its age. Measured against the old
# shape: a one-second-old decoy was enough. A run on no budget has no budget
# to compare against, so it falls back to this wrapper's default one, and
# `NSH_TEST_ABANDONED_AFTER` is how any run says otherwise.
ABANDONED_AFTER=${NSH_TEST_ABANDONED_AFTER:-$(
    /usr/bin/awk -v t="$TIMEOUT" -v d="$DEFAULT_BUDGET" \
        'BEGIN { if (t == 0) { print d; exit } c = int(t); if (c < t) c++; if (c < 1) c = 1; print c }'
)}
case $ABANDONED_AFTER in
    '' | *[!0-9]*)
        echo "scripts/sandboxed: NSH_TEST_ABANDONED_AFTER must be a number of seconds" >&2
        exit 2
        ;;
esac
if [[ $ABANDONED != ignore ]]; then
    mapfile -t ABANDONED_PIDS < <(abandoned_processes "$ABANDONED_AFTER")
    if ((${#ABANDONED_PIDS[@]})); then
        echo "scripts/sandboxed: uncontained processes have outlived this wrapper's own" >&2
        echo "${ABANDONED_AFTER}-second budget with nothing left to wait for them:" >&2
        /usr/bin/ps -o pid=,etime=,pcpu=,args= -p "${ABANDONED_PIDS[@]}" >&2 || :
        if [[ $ABANDONED == kill ]]; then
            kill -KILL "${ABANDONED_PIDS[@]}" 2>/dev/null || :
            echo "scripts/sandboxed: killed ${#ABANDONED_PIDS[@]} abandoned process(es)" >&2
        else
            echo "scripts/sandboxed: they are outside every boundary here and nothing bounds" >&2
            echo "them; refusing to measure a machine that is carrying them. Re-run with" >&2
            echo "NSH_TEST_ABANDONED=kill to clear them, or =ignore to keep them." >&2
            exit 1
        fi
    fi
fi

SANDBOX_ARGS=(
    "$SANDBOX" --quiet
    --unshare all
    --die-with-parent
    --new-session
    --close-fds
    --bind /:/:ro
    --dev /dev
    --proc /proc
    --tmpfs /tmp
    --chdir "$CHDIR"
    --limit "nproc=$NPROC"
)
# A program under /tmp is the one thing this boundary hides from itself: the
# root is bound read-only, so every path stays reachable except the fresh
# tmpfs that replaces /tmp. `rustdoc` compiles a merged doctest binary into
# /tmp/rustdoctestXXXXXX and hands cargo's runner that path, so without this
# `cargo test --workspace` ends on `env: '/tmp/.../rust_out': No such file or
# directory` -- the boundary working exactly as specified, on the wrong file.
# Only the directory holding the program comes back, and read-only, so a case
# still cannot see or touch what else is in the session's /tmp.
#
# THAT NARROWNESS IS ALSO A TRAP, AND IT COST A SESSION A DETOUR ON 2026-09-04.
# A whole `CARGO_TARGET_DIR` under /tmp -- the obvious place for a worktree
# measuring on its own, and what the house rules' "its own CARGO_TARGET_DIR"
# invites -- puts `deps/<test binary>` in scope and leaves its sibling
# `<profile>/nsh` out of it. Every test that starts `CARGO_BIN_EXE_nsh` then
# reports
#
#     start /tmp/.../debug/nsh: No such file or directory (os error 2)
#
# for a binary that is present, executable, `ldd`-clean and runs from a prompt,
# and the same test binary run straight out of `deps/` passes every case. It
# reads as a broken workspace and it is a statement about where the build tree
# is. Measured directly against this wrapper: a script in `deps/` sees its own
# directory holding one file and the profile directory above it holding only
# `deps`.
#
# It refuses rather than binding the tree back. The fuzz harness makes the same
# call for the same reason -- "the fuzz containment mounts an empty tmpfs over
# /tmp, so an oracle kept there is invisible to the targets; keep it outside
# /tmp" -- and widening a deliberately narrow read-only allowance into a
# writable build tree would spend the containment to save a path. /tmp is a
# tmpfs on this machine besides, so a build tree there is spending RAM to hide
# itself.
#
# `CACHEDIR.TAG` is cargo's own mark on the root of a build tree, which is what
# separates this from the rustdoc case: nothing above /tmp/rustdoctestXXXXXX
# carries one.
build_tree_of() { # build_tree_of PROGRAM
    local directory
    directory=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) || return 1
    while [[ $directory != / ]]; do
        [[ ! -f $directory/CACHEDIR.TAG ]] || {
            printf '%s\n' "$directory"
            return 0
        }
        directory=${directory%/*}
        [[ -n $directory ]] || directory=/
    done
    return 1
}

READABLES=()
if $RUNNER && [[ ${1-} == /tmp/* && -f ${1-} ]]; then
    if tree=$(build_tree_of "$1"); then
        echo "scripts/sandboxed: cargo asked to run a program from a build tree on /tmp:" >&2
        echo "scripts/sandboxed:   $1" >&2
        echo "scripts/sandboxed:   $tree  <- the CARGO_TARGET_DIR holding it" >&2
        echo "This boundary replaces /tmp with an empty tmpfs, so nothing in that tree" >&2
        echo "except the directory holding the program itself exists from inside it. A" >&2
        echo "test that starts CARGO_BIN_EXE_<name> fails with 'No such file or directory" >&2
        echo "(os error 2)' for a binary that is present, executable and runs from a" >&2
        echo "prompt -- which is about where the build tree is and not about the shell." >&2
        echo "Point CARGO_TARGET_DIR outside /tmp; a worktree's own target/ is the" >&2
        echo "intended place, and /tmp is RAM here as well as hidden." >&2
        exit 1
    fi
    READABLES+=("$(cd "$(dirname "$1")" && pwd -P)")
fi
for path in "${WRITABLES[@]}" "${READABLES[@]}"; do
    [[ $path != *:* ]] || {
        echo "scripts/sandboxed: bound path contains ':': $path" >&2
        exit 1
    }
done
for path in "${WRITABLES[@]}"; do
    SANDBOX_ARGS+=(--bind "$path:$path")
done
for path in "${READABLES[@]}"; do
    SANDBOX_ARGS+=(--bind "$path:$path:ro")
done

root_probe="$ROOT/.sandboxed-root-write-probe-$$"
[[ ! -e $root_probe ]] || {
    echo "scripts/sandboxed: containment probe path already exists: $root_probe" >&2
    exit 1
}
/bin/sleep 30 &
sentinel=$!
cleanup() {
    kill "$sentinel" 2>/dev/null || :
    wait "$sentinel" 2>/dev/null || :
    rmdir "$root_probe" 2>/dev/null || :
}
trap cleanup EXIT HUP INT TERM

host_pid_namespace=$(/usr/bin/readlink /proc/self/ns/pid)
host_net_namespace=$(/usr/bin/readlink /proc/self/ns/net)
if ! canary=$("${SANDBOX_ARGS[@]}" -- /usr/bin/env --default-signal -- /bin/sh -eu -c '
    fail() { printf "containment probe: %s\n" "$1" >&2; exit 91; }
    if test -e "/proc/$1" && test "$(/usr/bin/readlink "/proc/$1/ns/pid")" = "$2"; then
        fail "host pid is visible"
    fi
    test "$(/usr/bin/readlink /proc/self/ns/pid)" != "$2" || fail "PID namespace was not replaced"
    test "$(/usr/bin/readlink /proc/self/ns/net)" != "$3" || fail "network namespace was not replaced"
    if mkdir "$4" 2>/dev/null; then fail "read-only root accepted a write"; fi
    /usr/bin/awk -v expected="$5" '\''$1 == "Max" && $2 == "processes" { found=1; good=($3 == expected && $4 == expected) } END { exit !(found && good) }'\'' /proc/self/limits || fail "nproc limit is wrong"
    set -- $(/usr/bin/cut -d " " -f 6,7 "/proc/$$/stat")
    test "$1" -gt 0 || fail "command did not enter a private session"
    test "$2" = 0 || fail "command retained a controlling terminal"
    set -- /proc/[0-9]*
    test "$#" -le 16 || fail "too many host processes are visible"
    printf "%s\n" __NSH_TEST_SANDBOXED__
' sandboxed-probe "$sentinel" "$host_pid_namespace" "$host_net_namespace" "$root_probe" "$NPROC" 2>&1); then
    echo "scripts/sandboxed: containment failed: $canary" >&2
    exit 1
fi
[[ $canary == __NSH_TEST_SANDBOXED__ ]] || {
    echo "scripts/sandboxed: execution canary failed: $canary" >&2
    exit 1
}
[[ ! -e $root_probe ]] || {
    echo "scripts/sandboxed: sandbox wrote outside its explicit writable binds" >&2
    exit 1
}

kill "$sentinel" 2>/dev/null || :
wait "$sentinel" 2>/dev/null || :
trap - EXIT HUP INT TERM

# THE BUDGET IS SPENT INSIDE THE BOUNDARY, NOT BY SIGNALLING IT.
#
# This used to be `timeout "$TIMEOUT" sandbox ... -- env ... -- "$@"`, which
# times the command by signalling the sandbox process from out here. That is
# only reliable once the sandbox has finished setting up: a signal delivered
# during that window reaps the process this side holds and leaves the process
# tree inside it running, because the teardown that tree depends on had not
# been armed yet. `86d2ce6` measured the same shape in the survey runner --
# signalling 0 ms after spawn leaked a background descendant 6 times in 20 at
# load 32, 10 ms after spawn 5 times in 20, 50 ms after spawn 0 in 15 -- and
# fixed it by moving the budget inside. This wrapper was the last of the three
# that had not been moved.
#
# It was not leaking at the 900-second default, and that is exactly why it
# survived: the signal cannot land in a setup window nine hundred seconds
# away. `--timeout` and `NSH_TEST_TIMEOUT` are the documented knobs, and a
# focused run is where a small budget gets used, which is where the window
# reopens.
#
# There is nothing out here to wait for -- the sandbox offers no readiness
# this script can observe -- so nothing is timed from here that can be timed
# from in there. The inner `timeout` stands in front of the command inside the
# namespace, and the outer one is a backstop $BACKSTOP seconds wider, for a
# sandbox that never got as far as running anything. A command that exits is
# torn down by the sandbox's own reaper, as before.
exec /usr/bin/timeout "$OUTER_TIMEOUT" "${SANDBOX_ARGS[@]}" -- \
    /usr/bin/timeout --signal=TERM --kill-after=1 "$TIMEOUT" \
    /usr/bin/env --default-signal -- "$@"
