platforms (
    {
        platform "python/posix-harness"
        files (posix/harness/**/*.py posix/harness/*.json)
        checks {
            syntax {
                cmd "python3 -m compileall -q posix/harness"
            }
            test {
                cmd "python3 -m unittest discover -s posix/harness/tests -v"
            }
        }
    }
    // The Rust crates were unchecked until 2026-08-22: the gate ran only
    // the Python platform above, so nothing here was formatted or linted
    // on the way in. Two `clippy::type_complexity` findings and eight
    // rustfmt diffs had accumulated unnoticed.
    //
    // `--all-targets` is the point of the lint entry. Without it clippy
    // skips test targets, which is exactly where both findings were, and
    // the command exits 0 while the tree is dirty.
    //
    // Deliberately no `test` entry. `cargo test --workspace` spawns real
    // shells, and this repo requires those to run under
    // `scripts/sandboxed` so a misbehaving case cannot signal the
    // operator's terminal -- see enforce-survey-test-containment. A gate
    // command running them bare would reintroduce that hazard, and the
    // suite is far past the check budget besides. Run tests with
    // `export LOCPATH=$(./tests/build-locales.sh)` and then
    // `scripts/sandboxed -- cargo test --workspace`; the locale tests fail
    // rather than skip when that fixture is missing.
    //
    // CORRECTION 2026-09-02: the first half of that paragraph stands as
    // written and the second half no longer holds. `.cargo/config.toml` now
    // names `scripts/sandboxed --cargo-runner` as cargo's target runner, so a
    // gate command running `cargo test` bare could not reintroduce the hazard:
    // cargo puts every test binary in a PID namespace itself, and a boundary
    // it cannot establish fails the command. The entry stays absent for the
    // reason that is still true -- the suite measured 36 s at load 20 against
    // a 60 s check budget, which is a check that would start failing on a busy
    // machine rather than when the code is wrong. The recommended command is
    // also unchanged: the wrapper on the outside is what asks whether the
    // machine is carrying an abandoned case.
    {
        platform "rust/workspace"
        files (crates/**/*.rs crates/**/Cargo.toml Cargo.toml Cargo.lock)
        checks {
            fmt {
                cmd "cargo fmt --all --check"
                fix "cargo fmt --all"
            }
            lint {
                cmd "cargo clippy --workspace --all-targets -- -D warnings"
            }
            // `[spec:nsh:req:idiom.regression-gates]` asks for repository
            // checks that fail when a translated C idiom comes back -- a
            // `c_int`, a `CString`, an integer program counter, a labelled
            // block left by a `goto`. None of that has a runtime signature,
            // so it is read off the source rather than run. It lived in
            // `cargo test` until 2026-09-02, where a red run meant either
            // "the shell is broken" or "somebody renamed a function"; here
            // a red run means one thing.
            idiom {
                cmd "cargo run -q -p nsh-lint"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    // The source-to-source port is complete. Current work maintains the Rust
    // implementation against POSIX and pinned behavioral oracles.
    scope "maintenance"
}

// Oils shell-spec and Smoosh shell files are pinned third-party survey inputs.
// Their bytes are verified by nsh-survey and must not be rewritten to satisfy
// local source heuristics; repository-owned survey code and metadata remain
// gated.
stub-scan {
    exempt-paths (tests/surveys/oils/spec/** tests/surveys/smoosh/shell/**)
}

comment-smells {
    exempt-paths (tests/surveys/oils/spec/** tests/surveys/smoosh/shell/**)
}

// TWO KINDS OF CHECKED-IN PROSE WERE BEING CHARGED AS UNTESTED PRODUCTION
// CODE. The footprint gate's production LOC is tokei's, and for a language
// with no fidelity walker that is the whole of the file's code lines -- so a
// TOML register and a Styx plan file are billed exactly as a `.rs` file is,
// against a ratio no test of theirs can ever move.
//
// `crates/nsh-lint/FUNCTION_DENSITY.toml` is the register whose own header
// demands a paragraph per entry: "name the seam to split along", "an answer
// like 'it is big' is worthless". Registering `pattern.rs` on 2026-09-02 --
// which `function-density` *required* before it would pass -- added 23
// counted lines to a crate already at 278 test / 1870 prod, and the two
// gates then contradicted each other:
//
//     test-footprint: crates/nsh-lint: crate test:prod 0.147 < floor 0.200
//                     (278 test / 1893 prod, scope=crate, pre-image 0.149)
//
// No entry length passes. The gate charges growth, so one line refuses as
// surely as twenty-three, and shortening the answer is what the register
// explicitly forbids. Exempt, the register leaves 278 / 1851 = 0.150 on both
// sides of an entry of any length, so writing the answer costs nothing.
//
// `plan/**` is the same fact 250 times larger, and it was three days from
// biting. Every `nplan commit` stages `plan/main.styx`, whose nearest
// `Cargo.toml` ancestor is the workspace root, so every delivery commit is
// judged on a rollup of the entire tree -- measured 2026-09-03 at 20,547
// test / 101,716 prod = 0.2020 against the same 0.200 floor. Two milli of
// margin, with `plan/main.styx` contributing 10,405 production lines, no
// test lines, and 420 lines a day over the eight days to 2026-09-03. Exempt,
// that rollup is 20,547 / 91,211 = 0.2253 and no amount of planning erodes
// it.
//
// Nothing here is a ratio a test could have moved. The crates' own figure,
// which is the one the floor is about, is 19,699 / 49,283 = 0.400.
quality {
    exempt-paths (
        tests/surveys/oils/spec/**
        tests/surveys/smoosh/shell/**
        plan/**
        crates/nsh-lint/FUNCTION_DENSITY.toml
    )
    test-footprint {
        scope "crate"
    }
}
