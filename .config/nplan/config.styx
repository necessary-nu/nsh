platforms (
    {
        platform "python/posix-harness"
        files (posix/harness/**/*.py posix/harness/*.json)
        checks {
            syntax {
                cmd "python3 -m compileall -q posix/harness"
            }
            test {
                cmd "python3 -m unittest discover -s posix/harness/tests -v"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    // The source-to-source port is complete. Current work maintains the Rust
    // implementation against POSIX and pinned behavioral oracles.
    scope "maintenance"
}

// Oils shell-spec and Smoosh shell files are pinned third-party survey inputs.
// Their bytes are verified by nsh-survey and must not be rewritten to satisfy
// local source heuristics; repository-owned survey code and metadata remain
// gated.
stub-scan {
    exempt-paths (tests/surveys/oils/spec/** tests/surveys/smoosh/shell/**)
}

comment-smells {
    exempt-paths (tests/surveys/oils/spec/** tests/surveys/smoosh/shell/**)
}

quality {
    exempt-paths (tests/surveys/oils/spec/** tests/surveys/smoosh/shell/**)
    test-footprint {
        scope "crate"
    }
}
