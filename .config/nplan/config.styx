platforms (
    {
        platform "python/posix-harness"
        files (posix/harness/**/*.py posix/harness/*.json)
        checks {
            syntax {
                cmd "python3 -m compileall -q posix/harness"
            }
            test {
                cmd "python3 -m unittest discover -s posix/harness/tests -v"
            }
        }
    }
    {
        platform "c++"
        files (src/**/*.c src/**/*.cc src/**/*.cpp src/**/*.cxx src/**/*.h src/**/*.hpp include/**/*.h include/**/*.hpp)
        checks {
            format {
                cmd "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format --dry-run --Werror"
                fix "find src include -name '*.c' -o -name '*.cc' -o -name '*.cpp' -o -name '*.h' -o -name '*.hpp' | xargs clang-format -i"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}

// The C source is upstream dash and stays byte-identical, so its
// coverage claims live in plan/annotations.styx and never in source
// comments. The Rust target carries its claims inline as ordinary
// comments, which is what `@both` (the union of the two) allows.
annotations {
    mode @both
}

// Oils shell-spec files are pinned third-party survey inputs. Their bytes are
// verified by nsh-survey and must not be rewritten to satisfy local source
// heuristics; repository-owned survey code and metadata remain gated.
stub-scan {
    exempt-paths (tests/surveys/oils/spec/**)
}

comment-smells {
    exempt-paths (tests/surveys/oils/spec/**)
}

quality {
    exempt-paths (tests/surveys/oils/spec/**)
    test-footprint {
        scope "crate"
    }
}
